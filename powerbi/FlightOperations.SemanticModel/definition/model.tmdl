model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dim_month","dim_airline","dim_airport","dim_origin_airport","dim_dest_airport","dim_date","mart_network_monthly","mart_airline_monthly","mart_airport_daily","mart_route_monthly","mart_delay_causes","pPgServer","pPgDatabase"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_month
ref table dim_airline
ref table dim_airport
ref table dim_origin_airport
ref table dim_dest_airport
ref table dim_date
ref table mart_network_monthly
ref table mart_airline_monthly
ref table mart_airport_daily
ref table mart_route_monthly
ref table mart_delay_causes

ref cultureInfo en-US

