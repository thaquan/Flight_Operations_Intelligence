		summarizeBy: none
		sourceColumn: late_arrivals_15

	column on_time_arrivals
		dataType: int64
		isHidden
		lineageTag: be73ad8e-16e6-49e7-864d-6cbc498a3a81
		summarizeBy: none
		sourceColumn: on_time_arrivals

	partition mart_airline_monthly = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(pPgServer, pPgDatabase, [CreateNavigationProperties=false]),
				    Raw = Source{[Schema="gold", Item="mart_airline_monthly"]}[Data],
				    Selected = Table.SelectColumns(Raw, {"airline_sk", "source_month", "scheduled_flights", "completed_flights", "cancelled_flights", "diverted_flights", "eligible_arrivals", "late_arrivals_15", "on_time_arrivals"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"airline_sk", Int64.Type}, {"source_month", type date}, {"scheduled_flights", Int64.Type}, {"completed_flights", Int64.Type}, {"cancelled_flights", Int64.Type}, {"diverted_flights", Int64.Type}, {"eligible_arrivals", Int64.Type}, {"late_arrivals_15", Int64.Type}, {"on_time_arrivals", Int64.Type}})
				in
				    Typed

