table mart_network_monthly
	lineageTag: 42091f64-598f-44d7-9af3-4adc8443ad45

	/// Number of scheduled flight records in selected months.
	measure 'Scheduled Flights' = SUM('mart_network_monthly'[scheduled_flights])
		formatString: #,0
		displayFolder: 01 Network KPIs
		lineageTag: fc3d139a-b02c-418e-b037-ae3bd77f67ec

	/// Completed flights; includes one record with unknown arrival delay status.
	measure 'Completed Flights' = SUM('mart_network_monthly'[completed_flights])
		formatString: #,0
		displayFolder: 01 Network KPIs
		lineageTag: 05cf7d01-6ed2-43a4-82af-750eb442e4d7

	/// Completed arrivals with known 15 minute arrival-delay indicator.
	measure 'Eligible Arrivals' = SUM('mart_network_monthly'[eligible_arrivals])
		formatString: #,0
		displayFolder: 01 Network KPIs
		lineageTag: d79967bc-7ffb-48f9-ae25-7d83c31f39b1

	/// Eligible arrivals at least 15 minutes late.
	measure 'Late Arrivals 15+' = SUM('mart_network_monthly'[late_arrivals_15])
		formatString: #,0
		displayFolder: 01 Network KPIs
		lineageTag: 4f5e9cf2-8ee9-4ad2-ae2b-8872c1e8df25

	/// Eligible arrivals less than 15 minutes late.
	measure 'On-Time Arrivals' = SUM('mart_network_monthly'[on_time_arrivals])
		formatString: #,0
		displayFolder: 01 Network KPIs
		lineageTag: c4bb6a00-0a88-4542-a3fa-ddfb221eaf44

	/// Cancelled scheduled flights.
	measure 'Cancelled Flights' = SUM('mart_network_monthly'[cancelled_flights])
		formatString: #,0
		displayFolder: 01 Network KPIs
		lineageTag: 8aae9575-8a4a-4b92-90ab-7d1d430502e2

	/// Diverted scheduled flights.
	measure 'Diverted Flights' = SUM('mart_network_monthly'[diverted_flights])
		formatString: #,0
		displayFolder: 01 Network KPIs
		lineageTag: 234f6963-5fe1-4ea3-b79f-ce522da16ffe

	/// Late arrivals over eligible arrivals, not scheduled flights.
	measure 'Arrival Delay 15+ Rate' = DIVIDE([Late Arrivals 15+], [Eligible Arrivals])
		formatString: 0.00%
		displayFolder: 01 Network KPIs
		lineageTag: 08344fa0-79d1-4ba7-bd6a-6e3b4914446b

	/// On-time arrivals over eligible arrivals.
	measure 'Arrival On-Time Rate' = DIVIDE([On-Time Arrivals], [Eligible Arrivals])
		formatString: 0.00%
		displayFolder: 01 Network KPIs
		lineageTag: 24b87108-13dc-4756-a337-950dc1469281

	/// Cancelled flights over scheduled flights.
	measure 'Cancellation Rate' = DIVIDE([Cancelled Flights], [Scheduled Flights])
		formatString: 0.00%
		displayFolder: 01 Network KPIs
		lineageTag: 0abac2cc-a5fb-4349-bc60-6976d95d8b98

	/// Diverted flights over scheduled flights.
	measure 'Diversion Rate' = DIVIDE([Diverted Flights], [Scheduled Flights])
		formatString: 0.00%
		displayFolder: 01 Network KPIs
		lineageTag: 14c64fbb-1bac-4631-bb5f-e04d58672073

	column source_month
		dataType: dateTime
		isHidden
		formatString: yyyy-MM-dd
		lineageTag: 5ed77c07-8bf3-4abd-b5ff-09842fc18fc4
		summarizeBy: none
		sourceColumn: source_month

	column scheduled_flights
		dataType: int64
		isHidden
		lineageTag: b7a75244-3415-4ea3-b3a5-4e30dc587706
		summarizeBy: none
		sourceColumn: scheduled_flights

	column completed_flights
		dataType: int64
		isHidden
		lineageTag: f51dcd77-6c45-4756-a14e-1cc78faf2082
		summarizeBy: none
		sourceColumn: completed_flights

	column cancelled_flights
		dataType: int64
		isHidden
		lineageTag: 29a6ad6c-15ca-44a2-8a60-8cdc974cb0ad
		summarizeBy: none
		sourceColumn: cancelled_flights

	column diverted_flights
		dataType: int64
		isHidden
		lineageTag: f2a080a1-52ba-4ef5-af68-bd6cfcd671ef
		summarizeBy: none
		sourceColumn: diverted_flights

	column eligible_arrivals
		dataType: int64
		isHidden
		lineageTag: 4e9f6307-4402-4007-8e3d-eb1a0cf7e3a5
		summarizeBy: none
		sourceColumn: eligible_arrivals

	column late_arrivals_15
		dataType: int64
		isHidden
		lineageTag: e4f37f59-619e-4371-86e0-d238ffa15bb8
		summarizeBy: none
		sourceColumn: late_arrivals_15

	column on_time_arrivals
		dataType: int64
		isHidden
		lineageTag: 2f112607-6b57-46e5-a45b-c139054770fe
		summarizeBy: none
		sourceColumn: on_time_arrivals

	partition mart_network_monthly = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(pPgServer, pPgDatabase, [CreateNavigationProperties=false]),
				    Raw = Source{[Schema="gold", Item="mart_network_monthly"]}[Data],
				    Selected = Table.SelectColumns(Raw, {"source_month", "scheduled_flights", "completed_flights", "cancelled_flights", "diverted_flights", "eligible_arrivals", "late_arrivals_15", "on_time_arrivals"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"source_month", type date}, {"scheduled_flights", Int64.Type}, {"completed_flights", Int64.Type}, {"cancelled_flights", Int64.Type}, {"diverted_flights", Int64.Type}, {"eligible_arrivals", Int64.Type}, {"late_arrivals_15", Int64.Type}, {"on_time_arrivals", Int64.Type}})
				in
				    Typed

