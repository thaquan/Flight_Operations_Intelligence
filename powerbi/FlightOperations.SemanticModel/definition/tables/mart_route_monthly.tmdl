	partition mart_route_monthly = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(pPgServer, pPgDatabase, [CreateNavigationProperties=false]),
				    Raw = Source{[Schema="gold", Item="mart_route_monthly"]}[Data],
				    Selected = Table.SelectColumns(Raw, {"origin_airport_sk", "dest_airport_sk", "source_month", "scheduled_flights", "completed_flights", "cancelled_flights", "diverted_flights", "eligible_arrivals", "late_arrivals_15", "on_time_arrivals"}),
