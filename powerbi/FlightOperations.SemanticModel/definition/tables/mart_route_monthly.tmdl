table mart_route_monthly
	lineageTag: dae26ec9-937e-4c12-b5bf-3be96fbc57bd

	/// Direction-sensitive A-to-B route-month value; no airline dimension.
	measure 'Route Scheduled Flights' = SUM('mart_route_monthly'[scheduled_flights])
		formatString: #,0
		displayFolder: 04 Directed Routes
		lineageTag: 83e3e765-7123-4e08-a20a-5955c18be24c

	/// Direction-sensitive A-to-B route-month value; no airline dimension.
	measure 'Route Eligible Arrivals' = SUM('mart_route_monthly'[eligible_arrivals])
		formatString: #,0
		displayFolder: 04 Directed Routes
		lineageTag: b73d0760-6a14-4084-b877-d9ef699bf4eb

	/// Direction-sensitive A-to-B route-month value; no airline dimension.
	measure 'Route Late Arrivals 15+' = SUM('mart_route_monthly'[late_arrivals_15])
		formatString: #,0
		displayFolder: 04 Directed Routes
		lineageTag: 93a3c74c-1629-453c-bb06-c69b4f0456d8

	/// Direction-sensitive A-to-B route-month value; no airline dimension.
	measure 'Route Cancelled Flights' = SUM('mart_route_monthly'[cancelled_flights])
		formatString: #,0
		displayFolder: 04 Directed Routes
		lineageTag: 54c7bd55-b295-4635-adcc-fccba47fdcca

	/// Direction-sensitive A-to-B route-month value; no airline dimension.
	measure 'Route Diverted Flights' = SUM('mart_route_monthly'[diverted_flights])
		formatString: #,0
		displayFolder: 04 Directed Routes
		lineageTag: 95a91763-732c-43ac-a66e-06c272d4931c

	measure 'Route Delay 15+ Rate' = DIVIDE([Route Late Arrivals 15+], [Route Eligible Arrivals])
		formatString: 0.00%
		displayFolder: 04 Directed Routes
		lineageTag: 0f2adff0-8ecb-4e1e-9ff3-2f4165bccd5a

	measure 'Route Cancellation Rate' = DIVIDE([Route Cancelled Flights], [Route Scheduled Flights])
		formatString: 0.00%
		displayFolder: 04 Directed Routes
		lineageTag: a3d6e010-05c6-41a8-b60e-c07d4ae762d0

	column origin_airport_sk
		dataType: int64
		isHidden
		lineageTag: 3fc93c2c-74b5-4544-b067-1fd1401c4a4e
		summarizeBy: none
		sourceColumn: origin_airport_sk

	column dest_airport_sk
