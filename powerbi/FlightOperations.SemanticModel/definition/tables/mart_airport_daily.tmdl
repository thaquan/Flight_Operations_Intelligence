	partition mart_airport_daily = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(pPgServer, pPgDatabase, [CreateNavigationProperties=false]),
				    Raw = Source{[Schema="gold", Item="mart_airport_daily"]}[Data],
				    Selected = Table.SelectColumns(Raw, {"airport_sk", "airport_role", "flight_date_key", "flight_date", "scheduled_flights", "completed_flights", "cancelled_flights", "diverted_flights", "eligible_arrivals", "late_arrivals_15", "on_time_arrivals"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"airport_sk", Int64.Type}, {"airport_role", type text}, {"flight_date_key", Int64.Type}, {"flight_date", type date}, {"scheduled_flights", Int64.Type}, {"completed_flights", Int64.Type}, {"cancelled_flights", Int64.Type}, {"diverted_flights", Int64.Type}, {"eligible_arrivals", Int64.Type}, {"late_arrivals_15", Int64.Type}, {"on_time_arrivals", Int64.Type}}),
				    WithMonth = Table.AddColumn(Typed, "source_month", each Date.StartOfMonth([flight_date]), type date)
				in
				    WithMonth

